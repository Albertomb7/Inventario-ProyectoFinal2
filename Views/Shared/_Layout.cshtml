@using ProyectoWebInventario.Filters
<!DOCTYPE html>
<html>
<head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - Sistema de Inventario</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;700&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" />


    @Scripts.Render("~/bundles/modernizr")
    @Styles.Render("~/Content/css")


    <link href="~/Content/custom-dashboard.css?v=2" rel="stylesheet" />

    @* PARA AGREGAR ICONOS - B  *@
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">

    @* ANIMACIONES *@
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css" />

    @Styles.Render("~/Content/css")    @* incluye bootstrap y site.css *@
    <link href="~/Content/custom-dashboard.css?v=2" rel="stylesheet" />


</head>

@{
    bool puedeVerAlertas = PermisoAttributes.Check(Context, "VerAlertas");
    bool puedeVerInventario = PermisoAttributes.Check(Context, "VerInventario");
    bool puedeVerUsuarios = PermisoAttributes.Check(Context, "VerUsuarios");
    bool puedeVerMovimientos = PermisoAttributes.Check(Context, "VerMovimientoInventarios");
    bool puedeVerUbicaciones = PermisoAttributes.Check(Context, "VerUbicaciones");
    bool puedeVerProductos = PermisoAttributes.Check(Context, "VerProductos");
    bool puedeVerRoles = PermisoAttributes.Check(Context, "VerRols");
}

<body>
    <div class="dashboard-container">
        <div class="sidebar">
            <h2>Inventario</h2>
            <ul class="sidebar-nav">
                <li class="@(ViewBag.CurrentMenu == "Home" ? "active" : "")">
                    @Html.ActionLink("Tablero", "Index", "Home")
                </li>
                @if (puedeVerProductos)
                {
                    <li class="@(ViewBag.CurrentMenu == "Productos" ? "active" : "")">
                        @Html.ActionLink("Productos", "Index", "Productos")
                    </li>
                }
                @if (puedeVerUbicaciones)
                {
                    <li class="@(ViewBag.CurrentMenu == "Ubicaciones" ? "active" : "")">
                        @Html.ActionLink("Ubicaciones", "Index", "Ubicaciones")
                    </li>
                }
                @if (puedeVerMovimientos)
                {
                    <li class="@(ViewBag.CurrentMenu == "MovimientoInventarios" ? "active" : "")">
                        @Html.ActionLink("Movimientos", "Index", "MovimientoInventarios")
                    </li>
                }

                @if (puedeVerUsuarios)
                {
                    <li class="@(ViewBag.CurrentMenu == "Usuarios" ? "active" : "")">
                        @Html.ActionLink("Usuarios", "Index", "Usuarios")
                    </li>
                }
                @if (puedeVerInventario)
                {
                    <li class="@(ViewBag.CurrentMenu == "Inventario" ? "active" : "")">
                        @Html.ActionLink("Inventario", "Index", "Inventario")
                    </li>
                }
                @if (puedeVerAlertas)
                {
                    <li class="@(ViewBag.CurrentMenu == "Alertas" ? "active" : "")">
                        @Html.ActionLink("Alertas", "Index", "Alertas")
                    </li>
                }
                @if (puedeVerRoles)
                {
                    <li class="@(ViewBag.CurrentMenu == "Rols" ? "active" : "")">
                        @Html.ActionLink("Crear y Asignar Rol", "Index", "Rols")
                    </li>
                }

                    @if (Session["Usuario"] != null)
                    {
                        <li style="margin-top: 20px; background-color: #dc3545; border-radius: 5px;">
                            @* Esto crea el formulario POST que llama al AccountController *@
                            @using (Html.BeginForm("Logout", "Account", FormMethod.Post, new { id = "logoutForm" }))
                            {
                                @Html.AntiForgeryToken()

                                @* Este es el enlace que activa el formulario *@
                                <a href="javascript:document.getElementById('logoutForm').submit()" style="color: white; font-weight: bold;">
                                    <i class="fas fa-sign-out-alt"></i> Cerrar Sesión
                                </a>
                            }
                        </li>
                    }
                </ul>
        </div>
        <div class="main-content">

            @* --- INICIO: SECCIÓN DE NOTIFICACIONES AGREGADA --- *@
            @if (TempData["NotificationMessage"] != null)
            {
                string notificationType = TempData["NotificationType"] as string ?? "info";
                <div class="alert alert-@notificationType alert-dismissible" role="alert" style="margin-top: 20px;">
                    <button type="button" class="close" data-dismiss="alert" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                    @TempData["NotificationMessage"]
                </div>
            }
            @* --- FIN: SECCIÓN DE NOTIFICACIONES --- *@

            @RenderBody()
        </div>
    </div>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    @RenderSection("scripts", required: false)
</body>
</html>
<!DOCTYPE html>
<html>
<head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - Sistema de Inventario</title>
    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")

    <link href="~/Content/custom-dashboard.css" rel="stylesheet" />

</head>
<body>
    <div class="dashboard-container">
        <div class="sidebar">
            <h2>Inventario</h2>
            <ul class="sidebar-nav">
                <li class="active">@Html.ActionLink("Tablero", "Index", "Home")</li>
                <li>@Html.ActionLink("Productos", "Index", "Productos")</li>
                <li>@Html.ActionLink("Ubicaciones", "Index", "Ubicaciones")</li>

                <li>@Html.ActionLink("Movimientos", "Index", "MovimientoInventarios")</li>

                <li>@Html.ActionLink("Usuarios", "Index", "Usuarios")</li>
                <li>@Html.ActionLink("Inventario", "Index", "Inventario")</li>
                <li>@Html.ActionLink("Alertas", "Index", "Alertas")</li>
            </ul>
        </div>
        <div class="main-content">
            @RenderBody()
        </div>
    </div>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    @RenderSection("scripts", required: false)
</body>
</html>
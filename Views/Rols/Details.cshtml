@model ProyectoWebInventario.Models.Rol

@{
    ViewBag.Title = "Detalles del Rol";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Detalles del Rol</h2>

<div>
    <h4>Rol</h4>
    <hr />
    <dl class="dl-horizontal">
        <dt>@Html.DisplayNameFor(model => model.NombreRol)</dt>
        <dd>@Html.DisplayFor(model => model.NombreRol)</dd>

        <dt>@Html.DisplayNameFor(model => model.Descripcion)</dt>
        <dd>@Html.DisplayFor(model => model.Descripcion)</dd>
    </dl>
</div>

<div class="form-actions no-color">
    <a href="@Url.Action("Edit", new { id = Model.IdRol })"
       class="btn btn-primary btn-rounded btn-elevate"
       style="margin-right:10px;">
        Editar
    </a>
    <a href="@Url.Action("Index")"
       class="btn btn-warning text-white btn-rounded btn-elevate">
        Volver a la Lista
    </a>
</div>

@using ProyectoWebInventario.Filters;
@model IEnumerable<ProyectoWebInventario.Models.MovimientoInventario>

@{
    ViewBag.Title = "Movimientos del Inventario";
    Layout = "~/Views/Shared/_Layout.cshtml";
    int page = ViewBag.Page ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
    string busqueda = ViewBag.Busqueda as string;
}

@{
    bool puedeVerMovimientos = PermisoAttributes.Check(Context, "VerMovimientoInventarios");
    bool puedeEditarMovimientos = PermisoAttributes.Check(Context, "EditarMovimientoInventarios");
    bool puedeEliminarMovimientos = PermisoAttributes.Check(Context, "EliminarMovimientoInventarios");
}

<style>
    /* PAGINACIÓN NEGRA ELEGANTE */
    .pager {
        display: flex;
        gap: 6px;
        align-items: center;
        justify-content: center;
        margin-top: 14px;
        flex-wrap: wrap;
    }

        .pager a, .pager span {
            padding: 6px 10px;
            border-radius: 8px;
            text-decoration: none;
            border: 1px solid rgba(255,255,255,.3);
            color: #ffffff;
            background: rgba(0, 0, 0, 0.7);
            transition: all 0.3s ease;
        }

            .pager a:hover {
                background: rgba(255, 255, 255, 0.2);
                border-color: rgba(255,255,255,.5);
                transform: translateY(-1px);
            }

            /* ✅ ESTILOS PARA LINKS VISITADOS/ACTIVOS */
            .pager a:visited,
            .pager a:active,
            .pager a:focus {
                color: #ffffff !important;
                background: rgba(0, 0, 0, 0.7) !important;
                text-decoration: none !important;
            }

        .pager .active {
            background: #000000;
            border-color: #ffffff;
            color: #ffffff;
            font-weight: 600;
            box-shadow: 0 2px 8px rgba(255, 255, 255, 0.2);
        }

        /* ✅ ESTILO ESPECIAL PARA BOTONES DESHABILITADOS */
        .pager .disabled {
            opacity: .4;
            pointer-events: none;
            background: rgba(0, 0, 0, 0.4);
            border-color: rgba(255,255,255,.2);
            color: #ffffff !important; /* ← Asegura texto blanco */
        }

    /* Información de paginación */
    .pagination-info {
        text-align: center;
        color: rgba(255,255,255,.8);
        margin-top: 10px;
        font-size: 14px;
    }

    /* Esto evita que los links se pongan feos al hacer clic */
    .pager a:visited,
    .pager a:active,
    .pager a:focus {
        color: #ffffff !important;
        background: rgba(0, 0, 0, 0.7) !important;
        text-decoration: none !important;
    }

    /* Esto asegura que los botones deshabilitados se vean bien */
    .pager .disabled {
        color: #ffffff !important;
    }
</style>

<h2>Movimientos del Inventario</h2>

<p>
    <a href="@Url.Action("Create")" class="btn btn-primary">
        <i class="fas fa-exchange-alt"></i> Registrar Nuevo Movimiento
    </a>
</p>

<table class="table table-hover">
    <thead>
        <tr>
            <th>Fecha</th>
            <th>Producto</th>
            <th>Tipo</th>
            <th>Cantidad</th>
            <th>Ubicación Origen</th>
            <th>Ubicación Destino</th>
            <th>Usuario</th>
            <th>Observación</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@Html.DisplayFor(modelItem => item.Fecha)</td>
                <td>@Html.DisplayFor(modelItem => item.Producto.Nombre)</td>
                <td>
                    @if (item.TipoMovimiento != null && item.TipoMovimiento.Equals("Entrada", StringComparison.OrdinalIgnoreCase))
                    {
                        <span class="movement-badge status-entrada">@item.TipoMovimiento</span>
                    }
                    else
                    {
                        <span class="movement-badge status-salida">@(item.TipoMovimiento ?? "Salida")</span>
                    }
                </td>
                <td>@Html.DisplayFor(modelItem => item.Cantidad)</td>
                <td>@Html.DisplayFor(modelItem => item.Ubicacion.Descripcion)</td>
                <td>@Html.DisplayFor(modelItem => item.Ubicacion1.Descripcion)</td>
                <td>@Html.DisplayFor(modelItem => item.Usuario.NombreUsuario)</td>
                <td>@Html.DisplayFor(modelItem => item.Observacion)</td>
                <td>
                    <div class="btn-group" role="group">
                        @if (puedeEditarMovimientos)
                        {@Html.ActionLink("Editar", "Edit", new { id = item.IdMovimientoInventario },
new { @class = "btn btn-sm btn-primary me-1" })}
                        @if (puedeVerMovimientos)
                        {@Html.ActionLink("Detalles", "Details", new { id = item.IdMovimientoInventario },
new { @class = "btn btn-sm btn-warning me-1 text-white" })}

                        @if (puedeEliminarMovimientos)
                        {@Html.ActionLink("Eliminar", "Delete", new { id = item.IdMovimientoInventario },
new { @class = "btn btn-sm btn-danger" })}

                    </div>
                </td>

            </tr>
        }
    </tbody>
</table>


<!-- PAGINACIÓN CON CLASE ESPECÍFICA -->
<nav class="pager pagination-movimientos" aria-label="Paginación de movimientos">
    @{
        var prevDisabled = page <= 1 ? "disabled" : "";
        var nextDisabled = page >= totalPages ? "disabled" : "";

        Func<int, string> link = p => Url.Action("Index", "MovimientoInventarios",
            new { page = p, busqueda = busqueda });
    }

    <a class="@prevDisabled" href="@(page > 1 ? link(page - 1) : "#")">« Anterior</a>

    @for (int i = 1; i <= totalPages; i++)
    {
        if (i == page)
        {
            <span class="active">@i</span>
        }
        else
        {
            <a href="@link(i)">@i</a>
        }
    }

    <a class="@nextDisabled" href="@(page < totalPages ? link(page + 1) : "#")">Siguiente »</a>
</nav>

<!-- INFORMACIÓN CON CLASE ESPECÍFICA -->
<div class="pagination-info pagination-movimientos-info">
    Página @page de @totalPages -
    Mostrando @Model.Count() de @ViewBag.TotalItems movimientos
</div>
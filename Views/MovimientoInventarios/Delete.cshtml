@model ProyectoWebInventario.Models.MovimientoInventario

@{
    ViewBag.Title = "Eliminar Movimiento";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Eliminar Movimiento</h2>

<h3>¿Estás seguro de que quieres eliminar este registro?</h3>

<div>
    <h4>Movimiento de Inventario</h4>
    <hr />
    <dl class="dl-horizontal">
        <dt>@Html.DisplayNameFor(model => model.Fecha)</dt>
        <dd>@Html.DisplayFor(model => model.Fecha)</dd>

        <dt>@Html.DisplayNameFor(model => model.Cantidad)</dt>
        <dd>@Html.DisplayFor(model => model.Cantidad)</dd>

        <dt>@Html.DisplayNameFor(model => model.Observacion)</dt>
        <dd>@Html.DisplayFor(model => model.Observacion)</dd>

        <dt>@Html.DisplayNameFor(model => model.Producto.Nombre)</dt>
        <dd>@Html.DisplayFor(model => model.Producto.Nombre)</dd>

        <dt>@Html.DisplayNameFor(model => model.Ubicacion.Codigo)</dt>
        <dd>@Html.DisplayFor(model => model.Ubicacion.Codigo)</dd>

        <dt>@Html.DisplayNameFor(model => model.Ubicacion1.Codigo)</dt>
        <dd>@Html.DisplayFor(model => model.Ubicacion1.Codigo)</dd>

        <dt>@Html.DisplayNameFor(model => model.Usuario.NombreUsuario)</dt>
        <dd>@Html.DisplayFor(model => model.Usuario.NombreUsuario)</dd>
    </dl>

    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()

        <div class="form-actions no-color">
            <!-- Botones con separación, mismo estilo que el resto -->
            <input type="submit"
                   value="Eliminar Definitivamente"
                   class="btn btn-danger btn-rounded btn-elevate"
                   style="margin-right:10px;" />
            @Html.ActionLink("Cancelar y Volver", "Index", null,
                new { @class = "btn btn-warning text-white btn-rounded btn-elevate" })
        </div>
    }
</div>

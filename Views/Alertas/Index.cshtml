@model IEnumerable<ProyectoWebInventario.Models.AlertaReposicion>

@{
    ViewBag.Title = "Alertas de Reposición";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var page = (int)(ViewBag.Page ?? 1);
    var totalPages = (int)(ViewBag.TotalPages ?? 1);
    var totalItems = (int)(ViewBag.TotalItems ?? 0);
}

<style>
    /* PAGINACIÓN NEGRA ELEGANTE */
    .pager {
        display: flex;
        gap: 6px;
        align-items: center;
        justify-content: center;
        margin-top: 14px;
        flex-wrap: wrap;
    }

        .pager a, .pager span {
            padding: 6px 10px;
            border-radius: 8px;
            text-decoration: none;
            border: 1px solid rgba(255,255,255,.3);
            color: #ffffff;
            background: rgba(0, 0, 0, 0.7);
            transition: all 0.3s ease;
        }

            .pager a:hover {
                background: rgba(255, 255, 255, 0.2);
                border-color: rgba(255,255,255,.5);
                transform: translateY(-1px);
            }

            /* ✅ ESTILOS PARA LINKS VISITADOS/ACTIVOS */
            .pager a:visited,
            .pager a:active,
            .pager a:focus {
                color: #ffffff !important;
                background: rgba(0, 0, 0, 0.7) !important;
                text-decoration: none !important;
            }

        .pager .active {
            background: #000000;
            border-color: #ffffff;
            color: #ffffff;
            font-weight: 600;
            box-shadow: 0 2px 8px rgba(255, 255, 255, 0.2);
        }

        /* ✅ ESTILO ESPECIAL PARA BOTONES DESHABILITADOS */
        .pager .disabled {
            opacity: .4;
            pointer-events: none;
            background: rgba(0, 0, 0, 0.4);
            border-color: rgba(255,255,255,.2);
            color: #ffffff !important; /* ← Asegura texto blanco */
        }

    /* Información de paginación */
    .pagination-info {
        text-align: center;
        color: rgba(255,255,255,.8);
        margin-top: 10px;
        font-size: 14px;
    }

    /* Esto evita que los links se pongan feos al hacer clic */
    .pager a:visited,
    .pager a:active,
    .pager a:focus {
        color: #ffffff !important;
        background: rgba(0, 0, 0, 0.7) !important;
        text-decoration: none !important;
    }

    /* Esto asegura que los botones deshabilitados se vean bien */
    .pager .disabled {
        color: #ffffff !important;
    }


</style>
<h2 class="mb-3">Alertas de Reposición</h2>

@if (Model == null || !Model.Any())
{
    <div class="empty-state">
        <div class="empty-card">
            <div class="empty-illustration">
                <img src="@Url.Content("~/Content/img/SinAlertas.png")" alt="Sin alertas" />
            </div>
            <h3 class="empty-title">¡No hay alertas por ahora!</h3>
            <p class="empty-subtitle">
                Aquí aparecerán las alertas cuando el stock esté bajo o se cumplan tus reglas.
            </p>
        </div>
    </div>
}
else
{
    foreach (var item in Model)
    {
        <div class="alert alert-warning d-flex align-items-center shadow-sm alert-custom-warning mb-3" role="alert">
            <i class="bi bi-exclamation-triangle-fill d-flex justify-content-center align-items-center me-3 icono-alerta"></i>
            <div>
                <h5 class="mb-1">¡Atención!</h5>
                <p class="mb-0">El stock ha alcanzado o está por debajo del nivel mínimo.</p>
                <p class="mb-0">Producto: <strong>@item.Producto.Nombre</strong></p>
                <p class="mb-0">Unidades disponibles: <strong>@item.NivelActual</strong></p>
                <small class="text-muted">Fecha de generación: @item.FechaDeGeneracion</small>
            </div>
        </div>
    }

    @* --- Paginación --- *@
    if (totalPages > 1)
    {
        <nav class="pager pagination-alertas" aria-label="Paginación de alertas">
            @{
                var prevDisabled = page <= 1 ? "disabled" : "";
                var nextDisabled = page >= totalPages ? "disabled" : "";
                Func<int, string> link = p => Url.Action("Index", "Alertas", new { page = p });
            }

            <a class="@prevDisabled" href="@(page > 1 ? link(page - 1) : "#")">« Anterior</a>

            @for (int i = 1; i <= totalPages; i++)
            {
                if (i == page)
                {<span class="active">@i</span> }
            else
            { <a href="@link(i)">@i</a>}
    }

            <a class="@nextDisabled" href="@(page < totalPages ? link(page + 1) : "#")">Siguiente »</a>
        </nav>

        <div class="pagination-info text-center mt-2">
            Página @page de @totalPages — Mostrando @Model.Count() de @totalItems alertas
        </div>
    }
}

@model IEnumerable<ProyectoWebInventario.Models.AlertaReposicion>

@{
    ViewBag.Title = "Listado de Alerta";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Listado de Alertas</h2>

<p>
    @Html.ActionLink("Crear Nueva Alerta", "Create", null, new { @class = "btn btn-primary" })
</p>
<table class="table table-hover">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Producto.Nombre)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.NivelActual)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.FechaDeGeneracion)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.Producto.Nombre)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.NivelActual)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.FechaDeGeneracion)
                </td>
                <td>
                    @Html.ActionLink("Editar", "Edit", new { id = item.IdAlertaReposicion }) |
                    @Html.ActionLink("Detalles", "Details", new { id = item.IdAlertaReposicion }) |
                    @Html.ActionLink("Eliminar", "Delete", new { id = item.IdAlertaReposicion })
                </td>
            </tr>
        }
    </tbody>
</table>
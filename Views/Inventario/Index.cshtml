@model IEnumerable<ProyectoWebInventario.Models.Inventario>

@{
    ViewBag.Title = "Inventario Actual";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Inventario Actual</h2>

@*<p>
        @Html.ActionLink("Agregar Producto a Inventario", "Create", null, new { @class = "btn btn-primary" })
    </p>
*@


<table class="table table-hover">
    <thead>
        <tr>
            <th>@Html.DisplayNameFor(model => model.Stock)</th>
            <th>@Html.DisplayNameFor(model => model.Producto.Nombre)</th>
            <th>@Html.DisplayNameFor(model => model.Ubicacion.Descripcion)</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@Html.DisplayFor(modelItem => item.Stock)</td>
                <td>@Html.DisplayFor(modelItem => item.Producto.Nombre)</td>
                <td>@Html.DisplayFor(modelItem => item.Ubicacion.Descripcion)</td>
                <td>
                    <div class="btn-group" role="group">
                        @Html.ActionLink("Editar", "Edit", new { id = item.IdInventario }, new { @class = "btn btn-sm btn-primary me-1" })
                        @Html.ActionLink("Detalles", "Details", new { id = item.IdInventario }, new { @class = "btn btn-sm btn-warning me-1 text-white" })
                        @Html.ActionLink("Eliminar", "Delete", new { id = item.IdInventario }, new { @class = "btn btn-sm btn-danger" })
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>

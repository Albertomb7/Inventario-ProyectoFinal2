@model ProyectoWebInventario.Models.Ubicacion

@{
    ViewBag.Title = "Eliminar Ubicación";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Eliminar Ubicación</h2>

<h3>¿Está seguro que desea eliminar esta ubicación?</h3>

<div>
    <hr />
    <dl class="dl-horizontal">
        <dt>@Html.DisplayNameFor(model => model.Codigo)</dt>
        <dd>@Html.DisplayFor(model => model.Codigo)</dd>

        <dt>@Html.DisplayNameFor(model => model.Descripcion)</dt>
        <dd>@Html.DisplayFor(model => model.Descripcion)</dd>

        <dt>@Html.DisplayNameFor(model => model.Activo)</dt>
        <dd>@Html.DisplayFor(model => model.Activo)</dd>
    </dl>

    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()

        <div class="form-actions no-color mt-3">
            <div class="btn-group" role="group">
                <input type="submit" value="Eliminar" class="btn btn-danger btn-rounded btn-elevate me-2" />
                @Html.ActionLink("Cancelar y Volver", "Index", null,
                    new { @class = "btn btn-warning text-white btn-rounded btn-elevate" })
            </div>
        </div>
    }
</div>

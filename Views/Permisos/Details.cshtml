@model ProyectoWebInventario.Models.Permiso

@{
    ViewBag.Title = "Detalles del Permiso";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Detalles del Permiso</h2>

<div>

    <hr />
    <dl class="dl-horizontal">
        <dt>@Html.DisplayNameFor(model => model.NombrePermiso)</dt>
        <dd>@Html.DisplayFor(model => model.NombrePermiso)</dd>

        <dt>@Html.DisplayNameFor(model => model.Descripcion)</dt>
        <dd>@Html.DisplayFor(model => model.Descripcion)</dd>
    </dl>
</div>

<div class="form-actions no-color">
    <a href="@Url.Action("Edit", new { id = Model.IdPermiso })"
       class="btn btn-primary btn-rounded btn-elevate"
       style="margin-right:10px;">
        Editar
    </a>
    <a href="@Url.Action("Index")"
       class="btn btn-warning text-white btn-rounded btn-elevate">
        Volver a la Lista
    </a>
</div>

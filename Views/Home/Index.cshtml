@model ProyectoWebInventario.Models.DashboardViewModel

@{
    ViewBag.Title = "Tablero";
}

<div class="main-header">
    <h1>Sistema de Gestión de Inventarios</h1>
</div>

<div class="row summary-section">
    <div class="col-md-4">
        <div class="summary-card">
            <div class="card-icon icon-products">
                <i class="fas fa-box-open"></i>
            </div>
            <div class="card-info">
                <div class="card-title">@Model.TotalProductos</div>
                <div class="card-subtitle">Productos</div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="summary-card">
            <div class="card-icon icon-locations">
                <i class="fas fa-map-marker-alt"></i>
            </div>
            <div class="card-info">
                <div class="card-title">@Model.TotalUbicaciones</div>
                <div class="card-subtitle">Ubicaciones</div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="summary-card">
            <div class="card-icon icon-alerts">
                <i class="fas fa-exclamation-triangle"></i>
            </div>
            <div class="card-info">
                <div class="card-title">@Model.TotalAlertas</div>
                <div class="card-subtitle">Alertas</div>
            </div>
        </div>
    </div>
</div>


<div class="product-list">
    <h2>Últimos productos agregados</h2>
    <table class="table table-hover">
        <thead>
            <tr>
                <th>Nombre</th>
                <th>Categoría</th>
                <th>Marca</th>
                <th>Stock Mínimo</th>
                <th>Stock Actual</th>
                <th>Estado</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var producto in Model.UltimosProductos)
            {
                <tr>
                    <td>@producto.Nombre</td>
                    <td>@producto.Categoria</td>
                    <td>@producto.Marca</td>
                    <td>@producto.StockMinimo</td>
                    <td>@(producto.Inventarios != null ? producto.Inventarios.Sum(i => i.Stock) : 0)</td>
                    <td>
                        @if (producto.Activo == true)
                        {
                            <span class="label label-success">Activo</span>
                        }
                        else
                        {
                            <span class="label label-danger">Inactivo</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
@model ProyectoWebInventario.Models.DashboardViewModel

@{
    ViewBag.Title = "Tablero";
}

<div class="main-header">
    <h1>Sistema de Gestión de Inventarios para Almacén</h1>
</div>

<div class="summary-section">
    <h2>Resumen del inventario</h2>
    <div class="summary-cards">
        <div class="card">
            <div class="count">@Model.TotalProductos</div>
            <div class="label">Productos</div>
        </div>
        <div class="card">
            <div class="count">@Model.TotalUbicaciones</div>
            <div class="label">Ubicaciones</div>
        </div>
        <div class="card">
            <div class="count">@Model.TotalAlertas</div>
            <div class="label">Alertas</div>
        </div>
    </div>
</div>

<div class="product-list">
    <h2>Últimos productos agregados</h2>
    <table class="product-table">
        <thead>
            <tr>
                <th>Nombre</th>
                <th>Categoría</th>
                <th>Marca</th>
                <th>Stock Mínimo</th>
                <th>Estado</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var producto in Model.UltimosProductos)
            {
                <tr>
                    <td>@producto.Nombre</td>
                    <td>@producto.Categoria</td>
                    <td>@producto.Marca</td>
                    <td>@producto.StockMinimo</td>
                    <td>
                        @if (producto.Activo == true)
                        {
                            <span class="status-badge status-active">Activo</span>
                        }
                        else
                        {
                            <span class="status-badge status-inactive">Inactivo</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
@model ProyectoWebInventario.Models.Usuario

@{
    ViewBag.Title = "Eliminar Usuario";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Eliminar Usuario</h2>

<h3>¿Estás seguro de que deseas eliminar este usuario?</h3>
<p class="text-danger">
    Esta acción eliminará permanentemente el usuario y su acceso al sistema.
</p>

<div>

    <hr />
    <dl class="dl-horizontal">
        <dt>Nombre de Usuario</dt>
        <dd>@Html.DisplayFor(model => model.NombreUsuario)</dd>

        <dt>Contraseña</dt>
        <dd>@Html.DisplayFor(model => model.HasPassword)</dd>

        <dt>Rol</dt>
        <dd>@Html.DisplayFor(model => model.Rol)</dd>

        <dt>Estado</dt>
        <dd>
            @if (Model.Activo == true)
            {
                <span class="label label-success">Activo</span>
            }
            else
            {
                <span class="label label-danger">Inactivo</span>
            }
        </dd>
    </dl>

    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()

        <div class="form-actions no-color">
            <input type="submit"
                   value="Eliminar Usuario"
                   class="btn btn-danger btn-rounded btn-elevate"
                   style="margin-right:10px;" />
            <a href="@Url.Action("Index")"
               class="btn btn-warning text-white btn-rounded btn-elevate">
                Volver a la Lista
            </a>
        </div>
    }
</div>
